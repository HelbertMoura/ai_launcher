{
  "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
  "version": "{{VERSION}}",
  "description": "Desktop cockpit to detect, install and launch AI coding CLIs and IDEs.",
  "homepage": "https://github.com/HelbertMoura/ai_launcher",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "{{INSTALLER_URL}}#/ai-launcher-setup.exe",
      "hash": "{{SHA256}}"
    }
  },
  "installer": {
    "script": [
      "Start-Process -FilePath \"$dir\\ai-launcher-setup.exe\" -ArgumentList '/S' -Wait",
      "Remove-Item \"$dir\\ai-launcher-setup.exe\" -Force"
    ]
  },
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/HelbertMoura/ai_launcher/releases/download/v$version/AI.Launcher_$version_x64-setup.exe#/ai-launcher-setup.exe"
      }
    }
  }
}
