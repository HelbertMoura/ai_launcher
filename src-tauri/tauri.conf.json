{
  "$schema": "https://v2.tauri.app/schemas/config.schema.json",
  "productName": "AI Launcher",
  "version": "23.1.1",
  "identifier": "com.devmaniacs.ailauncher",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    },
    "windows": [
      {
        "title": "AI Launcher — by Helbert Moura | DevManiac's",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "maximized": true,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "AI Launcher"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "publisher": "Helbert Moura | DevManiac's",
    "copyright": "Copyright (c) 2026 Helbert Moura | DevManiac's",
    "category": "DeveloperTool",
    "shortDescription": "Desktop launcher for AI coding CLIs",
    "longDescription": "Centralized hub to discover, install, update and launch AI coding CLIs (Claude Code, Codex, Gemini, Antigravity, Qwen, Kilo Code, OpenCode, Crush, Droid) and developer tools (VS Code, Cursor, Windsurf) — single window, live install progress, no terminal flashing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["PortugueseBR", "English"],
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/HelbertMoura/ai_launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMkJGNzk0RTdCRjUxOEEKUldTS1ViL25sUGNyWVhjckZZYVk5MEREWEJOSW4rRzRDeVFQOHF5Z3M3UUFIWkpJRXZQSm1qcGYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
